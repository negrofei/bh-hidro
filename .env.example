# Copy to .env. Never commit secrets.

# Host CLI → already-running bh-mysql-prod (published 3308).
# docker compose overrides these two inside the app container (bh-mysql-prod:3306).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3308
DATABASE_NAME=bh_hidro
DATABASE_USER=operativo
DATABASE_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_CONTAINER=bh-mysql-prod
DOCKER_NETWORK=python3mysql_liberagro

# Same MySQL instance, different schema. Do not set this to bh_hidro.
SOURCE_DATABASE_NAME=fdc_database

# Paths for the host CLI (./logs, ./descargas, ./output).
# docker compose overrides these to /logs, /descargas, /output inside the app.
LOG_DIR=logs
DOWN_DIR=descargas
OUT_DIR=output

# Tileserver data dir bind-mounted at /output/tiles in the app container.
# Prod: /var/www/liberagro/geodata/tiles
# TILES_HOST_DIR=/var/www/liberagro/geodata/tiles

# Operative windows (days relative to today)
DELTA_DAYS_BACK=7
DELTA_DAYS_FORWARD=1
DELTA_DAYS_BACK_OUTPUT=1
DELTA_DAYS_FORWARD_OUTPUT=7

# Only this day may initialize almacenaje at 50% agua útil (no previous balance).
FIRST_DAY_OF_ALL_TIME=20000101

# CDS (ERALand). Point at a .cdsapirc, do not commit it.
CDSAPI_RC=/root/.cdsapirc

# NASA PPS IMERG (email as user and password). Do not commit the real values.
IMERG_USER=
IMERG_PASSWORD=

# SMN FTP for weekly IMERG Calib (Ajuste_YYYYMMDD.tif).
IMERG_FTP_HOST=
IMERG_FTP_USER=
IMERG_FTP_PASSWORD=
